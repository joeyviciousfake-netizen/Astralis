node_modules/
build/
.svelte-kit/
src/generated/
src-tauri/target/
src-tauri/gen/

# Conteúdo do projeto do editor (D29): abre vazio e só enche por Importar
# pack. O esqueleto (projects/default/**/.gitkeep + README.md) continua
# versionado — o que entra importado não vai para o git.
projects/default/backups/
projects/default/cards/*
projects/default/duelists/*
projects/default/decks/*
projects/default/arenas/*
projects/default/scenes/*
projects/default/layouts/*
projects/default/assets/*/*
projects/default/duel_setup.json

# ...exceto o esqueleto vazio, que precisa ficar de pé (senão a pasta nova
# não entra no clone e o primeiro Importar não acha projects/default/).
!projects/default/cards/.gitkeep
!projects/default/duelists/.gitkeep
!projects/default/decks/.gitkeep
!projects/default/arenas/.gitkeep
!projects/default/scenes/.gitkeep
!projects/default/assets/*/.gitkeep
!projects/default/README.md

# fusions.json e effects.json são GERADOS, não versionados: o esqueleto vazio
# nasce em garantir_projeto() (src-tauri/src/main.rs, main.rs:205) na
# primeira leitura, e depois de Importar um pack o fusions.json vira ~2,3 MB —
# versionar isso suja o git status e cria risco de commitar conteúdo
# importado pelo usuário (R8/R9).
# Para tirar o esqueleto do índice (o arquivo continua no disco):
#   git rm --cached astralis-studio/projects/default/fusions.json
#   git rm --cached astralis-studio/projects/default/effects.json
projects/default/fusions.json
projects/default/effects.json
