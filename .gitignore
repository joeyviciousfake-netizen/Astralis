# Engine Godot local (programa, ~172 MB) — não vai para o git
Godot/

# Cache do editor Godot (gerado ao abrir astralis/)
.godot/
*.godot.uid
*.gd.uid

# Builds e fitas geradas
*.astralis
build/
dist/

# Backups automáticos do botão IMPORTAR do Studio (gerados na hora, com data/hora)
astralis-studio/projects/default/backups/
astralis-studio/projects/*/backups/

# Molduras padrão copiadas p/ dados do projeto (o original versionado está em static/frames/)
astralis-studio/projects/default/assets/frames/
astralis-studio/projects/*/assets/frames/

# Studio (Rust/Tauri/Svelte)
astralis-studio/target/
astralis-studio/node_modules/
*.node

# Sistema
Thumbs.db
Desktop.ini

# Cache Python (tools/*.py geram ao compilar)
__pycache__/
*.pyc

# Blender: backup automático que o próprio Blender cria ao salvar por cima
# de um arquivo. É lixo sempre: o dono do arquivo é quem decide a versão.
*.blend1

# Documentacao do Blender 5.2 (o manual inteiro, do site docs.blender.org).
# Fica NA MAQUINA para consulta, e nao no git: sao 5.547 arquivos e 1,3 GB, e o
# repositorio nao versiona material de terceiro. A regra que manda e a R12:
# consultar a documentacao antes de fazer algo que nao se sabe. Como buscar
# dentro dela esta em `docs/17_BLENDER.md`.
blender_manual_v520_en.html/

# Documentacao do Godot (godot-docs, branch master = 4.8-dev). Fica NA MAQUINA
# para consulta e NAO no git: sao 3.605 arquivos e 443 MB de material de terceiro.
# A regra que manda e a R17: ler a documentacao antes de mexer no codigo. Onde
# procurar esta em `docs/17_BLENDER.md`.
Godot Documentation/
