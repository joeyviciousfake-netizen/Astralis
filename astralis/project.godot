; Engine configuration file.
; Astralis — Runtime (Godot 4.7). Ver docs/05_RUNTIME_DUELO.md e docs/13_TABULEIRO_DUELO.md.
; R1: Astralis é a única verdade de gameplay. R3: DATA != LOGIC.

config_version=5

[application]

config/name="Astralis"
config/description="Astralis — motor de duelos (runtime, única verdade de gameplay)."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")
